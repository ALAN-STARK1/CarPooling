<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.example.carpooling.mapper.UserMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into user(id,username,sex,password,email,phoneNumber,avatar,status,role)
        values
            (#{id},#{username},#{sex},#{password},#{email},#{phoneNumber},#{avatar},#{status},#{role})

    </insert>

    <select id="getUser" resultType="org.example.carpooling.entity.User">
        select * from user where #{id} = user.id;
    </select>

    <select id="login" resultType="org.example.carpooling.entity.User">
        select * from user where #{username} = username and #{password} = password
    </select>

</mapper>